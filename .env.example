# Copy to .env — NEVER commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Database (postgres default; sqlite for host-only work) ---
DB_ENGINE=postgres
DB_NAME=techbase
DB_USER=techbase
DB_PASSWORD=techbase
DB_HOST=db
DB_PORT=5432
# SQLITE_PATH=db.sqlite3            # used when DB_ENGINE=sqlite
# TEST_DB_ENGINE=sqlite             # or postgres (pgvector tests)

# --- Celery / Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# --- Meilisearch ---
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=dev-master-key-change-me

# --- Wagtail CMS (editorial admin) ---
# The admin lives at http://localhost:8000/cms/
WAGTAILADMIN_BASE_URL=http://localhost:8000
# The Wagtail site must point at how the backend is reached, or the admin
# shows every page as "outside any site".
WAGTAIL_SITE_HOSTNAME=localhost
WAGTAIL_SITE_PORT=8000

# --- LLM providers (optional; FakeLLM used when empty) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# anthropic | openai | fake — empty means "detect from the keys, else fake"
LLM_PROVIDER=
LLM_CHAT_MODEL=claude-sonnet-4-5
LLM_UNDERSTAND_MODEL=claude-haiku-4-5

# --- Embeddings ---
# hash = the dependency-free local fallback (works everywhere, no download).
# bge-m3 = the real model (needs `pip install sentence-transformers`).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# production option: EMBEDDING_PROVIDER=bge-m3
# lighter option: EMBEDDING_PROVIDER=e5 EMBEDDING_MODEL=intfloat/multilingual-e5-small EMBEDDING_DIM=384

# --- Optional tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Rate limits (per minute, per identity) ---
RATE_LIMIT_ANON=120/min
RATE_LIMIT_CHAT=20/min

# --- Privacy ---
# Personal data (emails, phone numbers, national IDs) is removed from the log
# lines. The raw question stays in the database, where the editorial team sees it.
SCRUB_LOGS=true

# --- Production (compose.prod.yaml) ---
# The public URL of the site — used for the sitemap, the canonical links and
# the structured data.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Set these in production; compose.prod.yaml refuses to start without them.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://techbase.example
# DB_PASSWORD=
# MEILI_MASTER_KEY=
# REDIS_PASSWORD=
